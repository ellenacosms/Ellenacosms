    {
      "id": "bbb081de-8d45-4b37-9573-1787e2ab836f",
      "name": "Prepare accepted campaign updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response=$input.first().json;\nif(!response.messages?.[0]?.id||response.messages[0].message_status!=='accepted')throw new Error('Meta acceptance not confirmed; leave sending row for manual reconciliation.');\nconst group=$('Send one recipient at a time').item.json;\nconst at=new Date().toISOString(),messageId=response.messages[0].id;\nreturn group.related_rows.map((r,i)=>({json:{id:r.id,prospect_id:r.prospect_id,expected_status:i===0?'sending':'approved_to_send',queue_status:i===0?'sent':'skipped_duplicate',sent_at:at,review_note:(r.review_note||'')+'\\n'+(i===0?'Meta accepted intro':'Duplicate suppressed; intro accepted for campaign row '+group.id)+' at '+at+'; message ID: '+messageId+'. Delivery not confirmed.',prospect_note:(r.prospect_note||'')+'\\nIntro accepted by Meta at '+at+'; message ID: '+messageId+'. Delivery not confirmed.'},pairedItem:{item:0}}));"
      }
    }
