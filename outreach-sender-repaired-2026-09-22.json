    {
      "id": "524684ce-fc64-45d6-8d7e-050a7fd6c903",
      "name": "Choose unique consented recipients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function normalizePhone(v){let p=String(v||'').replace(/\\D/g,'');if(p.startsWith('00'))p=p.slice(2);if(/^0\\d{9}$/.test(p))p='256'+p.slice(1);return p;}\nconst history=$('Load campaign history').all().map(x=>x.json);\nconst prospects=new Map($input.all().map(x=>[x.json.id,x.json]));\nconst key=r=>(r.outreach_cycle||'legacy')+'|'+normalizePhone(r.phone_number);\nconst blocked=new Set(history.filter(r=>['sent','sent_duplicate','followed_up','replied','sending','skipped_duplicate'].includes(r.queue_status)).map(key));\nconst groups=new Map();\nfor(const item of $('Load approved B2B campaign rows').all()){\n const r=item.json,p=prospects.get(r.prospect_id),phone=normalizePhone(r.phone_number);\n if(!p||p.do_not_contact||p.outreach_consent!=='granted'||p.review_status!=='approved'||!/^[1-9]\\d{7,14}$/.test(phone)||blocked.has(key(r)))continue;\n const g=groups.get(key(r))||[];\n g.push({...r,phone_number:phone,prospect_note:p.notes||''});\n groups.set(key(r),g);\n}\nreturn [...groups.values()].map(rows=>({json:{...rows[0],related_rows:rows}}));"
      }
    },
