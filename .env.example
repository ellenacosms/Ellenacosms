APP_NAME=ELLENA
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Leave blank on Linux unless PHP cannot use the system certificate store.
# If needed, use the server's CA bundle, for example /etc/ssl/certs/ca-certificates.crt.
GOOGLE_CA_BUNDLE=

PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_CURRENCY=UGX
PESAPAL_CALLBACK_URL="${APP_URL}/payments/pesapal/callback"
PESAPAL_IPN_URL="${APP_URL}/payments/pesapal/ipn"
PESAPAL_CANCELLATION_URL="${APP_URL}/dashboard#orders"
PESAPAL_CA_BUNDLE=
PESAPAL_TOKEN_CACHE_SECONDS=240

N8N_ORDER_WEBHOOK_URL=
N8N_ORDER_WEBHOOK_SECRET=
N8N_ORDER_WEBHOOK_HOSTS=
N8N_CA_BUNDLE=
N8N_CHECKOUT_SESSION_SECRET=
N8N_CHECKOUT_SESSION_MINUTES=30
N8N_CHECKOUT_MAX_AGE_SECONDS=300
PESAPAL_CACHE_STORE=database
CHECKOUT_UNPAID_EXPIRY_MINUTES=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=admin@ellenacosms.com
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
